# 로컬 개발용 환경 변수 예시입니다.
# 이 파일을 복사해서 .env 를 만들고(cp .env.example .env), 값을 채워 주세요.
# .env 는 저장소에 올라가지 않습니다. 비밀 값을 이 파일에 직접 적지 마세요.
# 값에 따옴표를 쓰지 마세요. 따옴표까지 값에 포함됩니다.

# DB 접속 주소 (호스트, 포트, DB 이름을 환경에 맞게 수정)
DB_URL=jdbc:mysql://localhost:3306/catservice?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# DB 계정
DB_USERNAME=change-me
DB_PASSWORD=change-me

# JWT 서명 키 (HS256 기준 32바이트 이상의 임의 문자열)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more